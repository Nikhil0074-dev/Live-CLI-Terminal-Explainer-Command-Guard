# Optional overrides (all have safe defaults)
# GUARD_HOME=~/.config/live-cli-guard
# GUARD_CONFIG=/path/to/config.json
# GUARD_HOOK_MODE=risky        # risky | all
# GUARD_HOOK_FAIL=closed       # closed | open  (what to do if the guard itself errors)
# GUARD_DISABLE=               # set to 1 to bypass the shell hook for the current shell
# NO_COLOR=1
