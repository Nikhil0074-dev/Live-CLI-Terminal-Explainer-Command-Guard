{
  "name": "live-cli-terminal-guard",
  "version": "1.0.0",
  "description": "AI-assisted terminal command explainer and deterministic command guard (Bash/Zsh, local Ollama).",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guard": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "integrations",
    "policies",
    "prompts",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration",
    "test:shell": "npm run build && node scripts/test-shell.cjs",
    "test:all": "npm run test && npm run test:shell",
    "verify": "node dist/cli.js doctor",
    "guard": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  }
}
